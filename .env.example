# ── MODE ──────────────────────────────────────────────
# local  = no cloud, no keys, no cost (free prototype)
# azure  = Azure AI Search + Azure OpenAI
APP_MODE=local

# ── RETRIEVAL ─────────────────────────────────────────
RETRIEVER_PROVIDER=local          # local | azure
TOP_K=4
LOCAL_INDEX_PATH=data/local_index.jsonl
CLINICAL_DOCS_DIR=docs/clinical

# ── LLM ───────────────────────────────────────────────
LLM_PROVIDER=gemini                # echo | ollama | azure 
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
TEMPERATURE=0.3
MAX_TOKENS=500

# ── AZURE AI SEARCH ───────────────────────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=wellness-knowledge-tr
AZURE_SEARCH_ANALYZER=tr.microsoft
# Semantic ranker requires Basic tier or above.
# Free tier does NOT support it. Leave false on free tier.
AZURE_SEARCH_USE_SEMANTIC=false
AZURE_SEARCH_SEMANTIC_CONFIG=default-semantic

# ── AZURE OPENAI ──────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── AZURE DOCUMENT INTELLIGENCE (PDF ingestion) ───────
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

GEMINI_API_KEY=AQ.Ab8RN6Ilk1DSWZqnROlYQ2NyL_F6NEQ99yeQqPjm5q5VjaWfiA
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# ── PRIVACY / SAFETY ──────────────────────────────────
REDACT_ENABLED=true
CRISIS_PROTOCOL_PATH=config/crisis_protocol.yaml
# What to do if the optional LLM crisis classifier errors.
# escalate = fail safe (recommended, more false positives)
# pass_through = rely on rule-based layer only
CRISIS_ON_CLASSIFIER_ERROR=escalate
LLM_CRISIS_CLASSIFIER_ENABLED=false

LOG_DIR=logs